rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins helper - check if user document has Super Admin role or exists in admins collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hkkk0288@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin() || isSignedIn();
    }

    // Products / Dishes Collection
    match /products/{productId} {
      allow read: if true; // Public menu catalog
      allow create, update, delete: if isValidId(productId) || isSignedIn(); // Staff or Admin can manage
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) || true;
      allow delete: if isAdmin();
    }

    // Table Orders Collection (Waiters & Kitchen)
    match /table_orders/{tableOrderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Slide Banners Collection (Hero promotions)
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
