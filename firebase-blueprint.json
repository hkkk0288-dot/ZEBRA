{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with system role, permissions, credentials metadata, and contact info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": {
          "type": "string",
          "enum": ["Super Admin", "Kitchen Manager", "Waiter", "Dispatcher", "Driver", "Customer"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "permissions": {
          "type": "object",
          "description": "Granular capability flags assigned by Admin"
        },
        "ordersCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "joinedDate": { "type": "string", "maxLength": 50 },
        "avatar": { "type": "string", "maxLength": 500 },
        "assignedBranch": { "type": "string", "maxLength": 100 },
        "tempPassword": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Dish or beverage offered at Zebra Restaurant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "swahiliName": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "priceTZS": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "calories": { "type": "number" },
        "prepTimeMinutes": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "restaurantName": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "price", "priceTZS", "category", "isAvailable"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food delivery order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "on_the_way", "delivered", "cancelled"]
        },
        "total": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "TZS"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "orderNumber", "status", "total", "currency", "paymentMethod"]
    },
    "TableOrder": {
      "title": "TableOrder",
      "description": "In-house restaurant dining table order placed by Waiter",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tableNumber": { "type": "string", "maxLength": 20 },
        "waiterName": { "type": "string", "maxLength": 100 },
        "waiterId": { "type": "string", "maxLength": 128 },
        "guestCount": { "type": "number" },
        "items": { "type": "array" },
        "totalTZS": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["ordered", "kitchen_prep", "ready_to_serve", "served", "paid", "closed"]
        },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "tableNumber", "waiterName", "status", "totalTZS"]
    },
    "SlideBanner": {
      "title": "SlideBanner",
      "description": "Hero sliding promotional banners managed by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tag": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 150 },
        "titleHighlight": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "promoCode": { "type": "string", "maxLength": 30 },
        "ussdNumber": { "type": "string", "maxLength": 30 },
        "bgGradient": { "type": "string", "maxLength": 100 },
        "accentColor": { "type": "string", "maxLength": 30 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "decorativeEmoji": { "type": "string", "maxLength": 20 },
        "targetCategory": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "orderIndex": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "description", "ctaText", "active"]
    },
    "LiveChat": {
      "title": "LiveChat",
      "description": "Real-time communication message between customer table and restaurant waiter",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["customer", "waiter", "admin"] },
        "tableNumber": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] }
      },
      "required": ["id", "roomId", "senderId", "senderName", "senderRole", "text"]
    },
    "LiveCall": {
      "title": "LiveCall",
      "description": "Live audio or video call log between customer table and waiter",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 128 },
        "callerId": { "type": "string", "maxLength": 128 },
        "callerName": { "type": "string", "maxLength": 100 },
        "callerRole": { "type": "string", "enum": ["customer", "waiter", "admin"] },
        "tableNumber": { "type": "string", "maxLength": 50 },
        "callType": { "type": "string", "enum": ["audio", "video"] },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "rejected", "missed"] },
        "startedAt": { "type": "number" },
        "durationSeconds": { "type": "number" }
      },
      "required": ["id", "roomId", "callerId", "callerName", "callType", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts with roles, contact details, and administrative permissions"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Menu items and dish catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Food delivery orders and payment transactions"
    },
    "/table_orders/{tableOrderId}": {
      "schema": "TableOrder",
      "description": "Dine-in table orders handled by Waiters and Kitchen"
    },
    "/banners/{bannerId}": {
      "schema": "SlideBanner",
      "description": "Hero promotional banners rotating on the home page"
    },
    "/live_chats/{chatId}": {
      "schema": "LiveChat",
      "description": "Live chat messages between dining tables and waiters"
    },
    "/live_calls/{callId}": {
      "schema": "LiveCall",
      "description": "Live audio/video call sessions and history"
    }
  }
}
